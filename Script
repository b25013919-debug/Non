-- Обновление ESP и Fullbright (с ограничением частоты, чтобы не грузить телефон)
local espTimer, lightTimer = 0, 0
track(RunService.Heartbeat:Connect(function(dt)
    lightTimer += dt
    if lightTimer >= 1 then
        lightTimer = 0
        if S.Fullbright then applyFullbright(true) end
    end

    espTimer += dt
    if espTimer < 0.2 then return end
    espTimer = 0

    if not S.ESP then
        if next(espData) then
            for plr in pairs(espData) do removeESP(plr) end
        end
        return
    end

    local myRoot = getRoot()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if root and hum then
                local d = espData[plr]
                if not d or d.char ~= char or not d.hl.Parent then
                    createESP(plr, char, root)
                    d = espData[plr]
                end
                if S.ESPInfo then
                    local dist = myRoot and math.floor((root.Position - myRoot.Position).Magnitude) or 0
                    d.lbl.Text = string.format("%s\n%dм | %d HP", plr.DisplayName, dist, math.floor(hum.Health))
                else
                    d.lbl.Text = ""
                end
            else
                removeESP(plr)
            end
        end
    end
end))

-- --- Камера-захват + FOV ---
local camTarget = nil

local function validTarget(plr, maxDist, fromPos)
    local char = plr.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return nil end
    if (root.Position - fromPos).Magnitude > maxDist then return nil end
    return root
end

track(RunService.RenderStepped:Connect(function()
    local cam = Workspace.CurrentCamera
    if not cam then return end

    if S.FOVOn then
        cam.FieldOfView = S.FOV
    end

    if S.CamLock then
        local myRoot = getRoot()
        if myRoot then
            local targetRoot = nil
            if camTarget then
                targetRoot = validTarget(camTarget, S.CamLockRange * 1.25, myRoot.Position)
            end
            if not targetRoot then
                camTarget = nil
                local best = math.huge
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer then
                        local r = validTarget(plr, S.CamLockRange, myRoot.Position)
                        if r then
                            local d = (r.Position - myRoot.Position).Magnitude
                            if d < best then
                                best = d
                                camTarget = plr
                                targetRoot = r
                            end
                        end
                    end
                end
            end
            if targetRoot then
                local goal = CFrame.lookAt(cam.CFrame.Position, targetRoot.Position)
                cam.CFrame = cam.CFrame:Lerp(goal, S.CamLockSmooth)
            end
        end
    else
        camTarget = nil
    end
end))

