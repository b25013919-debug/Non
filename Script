        TextSize = 13,
        TextColor3 = Color3.new(1, 1, 1),
        TextStrokeTransparency = 0.4,
        Text = "",
    }, bb)
    espData[plr] = { hl = hl, bb = bb, lbl = lbl, char = char }
end

