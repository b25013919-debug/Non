-- Запоминаем соединение, чтобы отключить его при выгрузке
local function track(conn)
    Claude.Connections[#Claude.Connections + 1] = conn
    return conn
end

-- Запоминаем функцию очистки
local function onCleanup(fn)
    Claude.Cleanups[#Claude.Cleanups + 1] = fn
end

function Claude.Unload()
    for _, fn in ipairs(Claude.Cleanups) do
        pcall(fn)
    end
    for _, c in ipairs(Claude.Connections) do
        pcall(function() c:Disconnect() end)
    end
    Claude.Connections = {}
    Claude.Cleanups = {}
    if Claude.Gui then pcall(function() Claude.Gui:Destroy() end) end
    if Claude.Folder then pcall(function() Claude.Folder:Destroy() end) end
    Claude.Gui = nil
    Claude.Folder = nil
    if env.ClaudeTSB == Claude then
        env.ClaudeTSB = nil
    end
end

