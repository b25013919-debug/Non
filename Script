                BorderSizePixel = 0,
            }, parent)
            local base = new("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(0, cx, 0, 85),
                Size = UDim2.new(0, 46, 0, 5),
                BackgroundColor3 = C.accent,
                BorderSizePixel = 0,
            }, parent)
            corner(base, 3)
        else
            local body = new("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(0, cx, 0, 48),
                Size = UDim2.new(0, 48, 0, 84),
                BackgroundColor3 = C.item,
                BorderSizePixel = 0,
            }, parent)
            corner(body, 10)
            stroke(body, C.accent, 3)
            local notch = new("Frame", {
                AnchorPoint = Vector2.new(0.5, 0),
                Position = UDim2.new(0.5, 0, 0, 5),
                Size = UDim2.new(0, 16, 0, 4),
                BackgroundColor3 = C.accent,
                BorderSizePixel = 0,
            }, body)
            corner(notch, 2)
            for i = 1, 3 do
                local l = new("Frame", {
                    Position = UDim2.new(0, 8, 0, 18 + (i - 1) * 11),
                    Size = UDim2.new(i == 2 and 0.4 or 0.7, 0, 0, 5),
                    BackgroundColor3 = C.accent,
                    BackgroundTransparency = 0.3,
                    BorderSizePixel = 0,
                }, body)
                corner(l, 2)
            end
            local home = new("Frame", {
                AnchorPoint = Vector2.new(0.5, 1),
                Position = UDim2.new(0.5, 0, 1, -5),
                Size = UDim2.new(0, 18, 0, 3),
                BackgroundColor3 = C.accent,
                BorderSizePixel = 0,
            }, body)
            corner(home, 2)
        end
    end

    local function makeCard(centerX, kind, name, hint)
        local card = new("TextButton", {
            AnchorPoint = Vector2.new(0.5, 0),
            Position = UDim2.new(0, centerX, 0, 140),
            Size = UDim2.new(0, 220, 0, 176),
            BackgroundColor3 = C.panel,
            Text = "",
            AutoButtonColor = false,
            BorderSizePixel = 0,
        }, cards)
        corner(card, 16)
        local st = stroke(card, C.off, 2)

        local iconHolder = new("Frame", {
            Position = UDim2.new(0, 0, 0, 8),
            Size = UDim2.new(1, 0, 0, 96),
            BackgroundTransparency = 1,
        }, card)
        drawIcon(iconHolder, kind)

        new("TextLabel", {
            Position = UDim2.new(0, 0, 0, 108),
            Size = UDim2.new(1, 0, 0, 24),
            BackgroundTransparency = 1,
            Text = name,
            TextColor3 = C.text,
            Font = Enum.Font.GothamBold,
            TextSize = 20,
        }, card)
        new("TextLabel", {
            Position = UDim2.new(0, 10, 0, 134),
            Size = UDim2.new(1, -20, 0, 34),
            BackgroundTransparency = 1,
            Text = hint,
            TextColor3 = C.dim,
            Font = Enum.Font.Gotham,
            TextSize = 12,
            TextWrapped = true,
        }, card)

        if kind == recommended then
            local tag = new("TextLabel", {
                AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -8, 0, 8),
                Size = UDim2.new(0, 92, 0, 18),
                BackgroundColor3 = C.accent,
                Text = "РЕКОМЕНДУЕМ",
                TextColor3 = Color3.new(1, 1, 1),
                Font = Enum.Font.GothamBold,
                TextSize = 10,
                BorderSizePixel = 0,
            }, card)
            corner(tag, 9)
        end

        card.MouseEnter:Connect(function()
            tween(st, 0.2, { Color = C.accent })
            tween(card, 0.2, { BackgroundColor3 = C.item })
        end)
        card.MouseLeave:Connect(function()
            if chosen ~= kind then
                tween(st, 0.2, { Color = C.off })
                tween(card, 0.2, { BackgroundColor3 = C.panel })
            end
        end)
        card.MouseButton1Click:Connect(function()
            if chosen then return end
            chosen = kind
            tween(st, 0.2, { Color = C.accent2, Thickness = 3 })
            tween(card, 0.2, { BackgroundColor3 = C.item })
        end)
    end

    makeCard(198, "pc", "ПК", "Компактное меню, клавиша RightShift для скрытия")
    makeCard(442, "phone", "ТЕЛЕФОН", "Крупные кнопки, плавающая кнопка и кнопки полёта")

    tween(cards, 0.6, { GroupTransparency = 0, Position = UDim2.new(0, 0, 0, 0) })

    -- Ждём выбор пользователя
    while not chosen and Claude.Gui do
        task.wait(0.05)
    end
    if not Claude.Gui then return end

    local device = chosen
    local deviceName = (device == "phone") and "Телефон" or "ПК"
    task.wait(0.4)
    tween(cards, 0.4, { GroupTransparency = 1 }, Enum.EasingStyle.Quad)
    tween(sub, 0.3, { TextTransparency = 1 }, Enum.EasingStyle.Quad)
    task.wait(0.45)
    cards:Destroy()

    -- ---- ЛОАДЕР ----
    local loader = new("CanvasGroup", {
        Size = UDim2.new(0, 640, 0, 360),
        BackgroundTransparency = 1,
        GroupTransparency = 1,
    }, content)

    local status = new("TextLabel", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 320, 0, 250),
        Size = UDim2.new(0, 360, 0, 22),
        BackgroundTransparency = 1,
        Text = "Подготовка...",
        TextColor3 = C.text,
        Font = Enum.Font.GothamMedium,
        TextSize = 15,
    }, loader)

    local barBg = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 320, 0, 284),
        Size = UDim2.new(0, 320, 0, 8),
        BackgroundColor3 = C.item,
        BorderSizePixel = 0,
    }, loader)
    corner(barBg, 4)
    local fill = new("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
    }, barBg)
    corner(fill, 4)
    new("UIGradient", { Color = ColorSequence.new(C.accent, C.accent2) }, fill)

    local pct = new("TextLabel", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 320, 0, 310),
        Size = UDim2.new(0, 100, 0, 18),
        BackgroundTransparency = 1,
        Text = "0%",
        TextColor3 = C.dim,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
    }, loader)

    tween(loader, 0.4, { GroupTransparency = 0 }, Enum.EasingStyle.Quad)
    task.wait(0.3)

    local shown = 0
    local function advance(target, text, dur)
        status.Text = text
        tween(fill, dur, { Size = UDim2.new(target / 100, 0, 1, 0) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
        local steps = math.max(target - shown, 1)
        for p = shown + 1, target do
            pct.Text = p .. "%"
            task.wait(dur / steps)
        end
        shown = target
    end

    advance(18, "Загрузка ассетов...", 0.7)
    advance(42, "Загрузка функций...", 0.7)

    -- Реальная сборка меню под выбранное устройство
    local menu = nil
    status.Text = "Сборка интерфейса: " .. deviceName .. "..."
    local okBuild, res = pcall(BuildMenu, device)
    if okBuild then
        menu = res
    else
        warn("[Claude] Ошибка сборки меню: " .. tostring(res))
    end
    advance(72, "Сборка интерфейса: " .. deviceName .. "...", 0.6)

    -- Ждём персонажа (максимум 3 секунды)
    status.Text = "Проверка персонажа..."
    local t0 = os.clock()
    while not getRoot() and os.clock() - t0 < 3 do
        task.wait(0.1)
    end
    advance(90, "Проверка персонажа...", 0.4)
    advance(100, "Готово!", 0.4)
    task.wait(0.4)

    -- Плавное исчезновение лоадера
    tween(splash, 0.7, { GroupTransparency = 1 }, Enum.EasingStyle.Quad)
    task.wait(0.75)
    spin:Cancel()
    splash:Destroy()

    if menu then
        menu.Open()
        notify("Claude загружен | " .. deviceName)
    else
        notify("Ошибка сборки меню, смотри консоль")
    end
end

-- ========== ЗАПУСК ==========
task.spawn(function()
    local ok, err = pcall(RunSequence)
    if not ok then
        warn("[Claude] Ошибка: " .. tostring(err))
    end
end)
