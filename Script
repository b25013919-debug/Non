        local state = default and true or false
        local function render(anim)
            local pc = state and C.accent or C.off
            local kp = state and UDim2.new(1, -21, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
            if anim then
                tween(pill, 0.2, { BackgroundColor3 = pc })
                tween(knob, 0.25, { Position = kp }, Enum.EasingStyle.Back)
            else
                pill.BackgroundColor3 = pc
                knob.Position = kp
            end
        end
        render(false)

        row.MouseButton1Click:Connect(function()
            state = not state
            render(true)
            pcall(cb, state)
            notify(text .. (state and ": ВКЛ" or ": ВЫКЛ"))
        end)
    end

